# Supabase Connection URL (Transaction pooler on port 6543 or direct port 5432)
# Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Project API URL & Publishable Anon Key (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
PRIMARY_ADMIN_EMAIL=marerec402@gmail.com